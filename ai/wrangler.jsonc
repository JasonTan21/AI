{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theusefulhacker-ai",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  },
}
